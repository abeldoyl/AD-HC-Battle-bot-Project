  8479  0FEB                     FSR1H_SHAD      equ	4075
  8480  0000                     FSR1H_SHAD_FSR1H_SHAD_POSN equ	0
  8481  0000                     FSR1H_SHAD_FSR1H_SHAD_POSITION equ	0
  8482  0008                     FSR1H_SHAD_FSR1H_SHAD_SIZE equ	8
  8483  0008                     FSR1H_SHAD_FSR1H_SHAD_LENGTH equ	8
  8484  00FF                     FSR1H_SHAD_FSR1H_SHAD_MASK equ	255
  8485  0FED                     STKPTR          equ	4077
  8486  0000                     STKPTR_STKPTR_POSN equ	0
  8487  0000                     STKPTR_STKPTR_POSITION equ	0
  8488  0005                     STKPTR_STKPTR_SIZE equ	5
  8489  0005                     STKPTR_STKPTR_LENGTH equ	5
  8490  001F                     STKPTR_STKPTR_MASK equ	31
  8491  0FEE                     TOSL            equ	4078
  8492  0000                     TOSL_TOSL_POSN  equ	0
  8493  0000                     TOSL_TOSL_POSITION equ	0
  8494  0008                     TOSL_TOSL_SIZE  equ	8
  8495  0008                     TOSL_TOSL_LENGTH equ	8
  8496  00FF                     TOSL_TOSL_MASK  equ	255
  8497  0FEF                     TOSH            equ	4079
  8498  0000                     TOSH_TOSH_POSN  equ	0
  8499  0000                     TOSH_TOSH_POSITION equ	0
  8500  0007                     TOSH_TOSH_SIZE  equ	7
  8501  0007                     TOSH_TOSH_LENGTH equ	7
  8502  007F                     TOSH_TOSH_MASK  equ	127
  8503                           
  8504                           	psect	code
  8505  0000'                    Setup:
  8506                           
  8507                           ; Bank 0 Setup
  8508                           ; Clear all program variables
  8509  0000' 0020               	banksel	32
  8510  0001' 01A0               	clrf	32
  8511  0002' 01A1               	clrf	33
  8512  0003' 01A2               	clrf	34
  8513  0004' 01A3               	clrf	35
  8514  0005' 01A4               	clrf	36
  8515  0006' 01A5               	clrf	37
  8516  0007' 01A6               	clrf	38
  8517  0008' 01A7               	clrf	39
  8518  0009' 01A8               	clrf	40
  8519  000A' 01A9               	clrf	41
  8520  000B' 01AA               	clrf	42
  8521  000C' 01AB               	clrf	43
  8522  000D' 01AC               	clrf	44
  8523  000E' 01AD               	clrf	45
  8524  000F' 01AE               	clrf	46
  8525                           
  8526                           ; Start output pins LOW
  8527  0010' 0022               	banksel	268
  8528  0011' 018C               	clrf	268
  8529  0012' 018E               	clrf	270
  8530                           
  8531                           ; Clear interrupt flags
  8532  0013' 0020               	banksel	17
  8533  0014' 1011               	bcf	17,0	; Clear Timer1 flag
  8534  0015' 1091               	bcf	17,1	; Clear Timer2 flag
  8535                           
  8536                           ; Disable interrupts during setup
  8537  0016' 0020               	banksel	11
  8538  0017' 138B               	bcf	11,7	; Global interrupts OFF
  8539  0018' 130B               	bcf	11,6	; Peripheral interrupts OFF
  8540                           
  8541                           ; Bank 1 Setup
  8542                           ; Set internal oscillator to 16 MHz
  8543                           ; PLL disabled
  8544  0019' 0021               	banksel	153
  8545  001A' 3078               	movlw	120
  8546  001B' 0099               	movwf	153
  8547                           
  8548                           ; ((PORTA) and 0x7F), 0 and ((PORTA) and 0x7F), 1 are motor direction outputs
  8549  001C' 0021               	banksel	140
  8550  001D' 100C               	bcf	140,0
  8551  001E' 108C               	bcf	140,1
  8552                           
  8553                           ; Keep PWM outputs disabled during setup
  8554  001F' 0021               	banksel	142
  8555  0020' 148E               	bsf	142,1	; ((PORTC) and 0x7F), 1 / CCP2
  8556  0021' 150E               	bsf	142,2	; ((PORTC) and 0x7F), 2 / CCP1
  8557                           
  8558                           ; UART pin directions
  8559  0022' 130E               	bcf	142,6	; ((PORTC) and 0x7F), 6 / TX
  8560  0023' 178E               	bsf	142,7	; ((PORTC) and 0x7F), 7 / RX
  8561                           
  8562                           ; Timer2 period
  8563                           ; PWM Frequency = 3906.25 Hz
  8564  0024' 0020               	banksel	27
  8565  0025' 30FF               	movlw	255
  8566  0026' 009B               	movwf	27
  8567                           
  8568                           ; Enable Timer1 interrupt
  8569  0027' 0021               	banksel	145
  8570  0028' 1411               	bsf	145,0	; ((PIE1) and 0x7F), 0 = 1
  8571                           
  8572                           ; Bank 2 Setup
  8573                           ; Set PORTA and PORTC to digital
  8574  0029' 0023               	banksel	396
  8575  002A' 018C               	clrf	396
  8576  002B' 018E               	clrf	398
  8577                           
  8578                           ; Default UART and CCP pin locations
  8579                           ; CCP1 = ((PORTC) and 0x7F), 2
  8580                           ; CCP2 = ((PORTC) and 0x7F), 1
  8581                           ; TX = ((PORTC) and 0x7F), 6
  8582                           ; RX = ((PORTC) and 0x7F), 7
  8583  002C' 0022               	banksel	285
  8584  002D' 019D               	clrf	285
  8585                           
  8586                           ; UART Setup
  8587                           ; 115200 Baud at 16 MHz
  8588                           ; ((TX1STA) and 0x7F), 2 = 1, ((BAUD1CON) and 0x7F), 3 = 1
  8589                           ; Actual baud = approximately 114286
  8590  002E' 0023               	banksel	415
  8591  002F' 3008               	movlw	8
  8592  0030' 009F               	movwf	415
  8593  0031' 0023               	banksel	412
  8594  0032' 019C               	clrf	412
  8595  0033' 0023               	banksel	411
  8596  0034' 3022               	movlw	34
  8597  0035' 009B               	movwf	411
  8598                           
  8599                           ; Asynchronous UART, 8-bit
  8600                           ; High-speed transmitter enabled
  8601  0036' 0023               	banksel	414
  8602  0037' 3024               	movlw	36
  8603  0038' 009E               	movwf	414
  8604                           
  8605                           ; Enable serial port and receiver
  8606  0039' 0023               	banksel	413
  8607  003A' 3090               	movlw	144
  8608  003B' 009D               	movwf	413
  8609                           
  8610                           ; PWM Setup
  8611                           ; Start both motors stopped
  8612  003C' 0025               	banksel	657
  8613  003D' 0191               	clrf	657
  8614  003E' 0025               	banksel	664
  8615  003F' 0198               	clrf	664
  8616                           
  8617                           ; Enable CCP1 PWM mode
  8618  0040' 0025               	banksel	659
  8619  0041' 300C               	movlw	12
  8620  0042' 0093               	movwf	659
  8621                           
  8622                           ; Enable CCP2 PWM mode
  8623  0043' 0025               	banksel	666
  8624  0044' 300C               	movlw	12
  8625  0045' 009A               	movwf	666
  8626                           
  8627                           ; Timer1 Setup
  8628                           ; 16 MHz oscillator = 4 MHz instruction clock
  8629                           ; Timer1 prescaler = 1:8
  8630                           ; Each tick = 2 microseconds
  8631                           ; 50 ms = 25000 counts
  8632                           ; 65536 - 25000 = 0x9E58
  8633  0046' 0020               	banksel	24
  8634  0047' 0198               	clrf	24	; Timer1 OFF during setup
  8635  0048' 0020               	banksel	25
  8636  0049' 0199               	clrf	25
  8637  004A' 0020               	banksel	23
  8638  004B' 309E               	movlw	158
  8639  004C' 0097               	movwf	23
  8640  004D' 3058               	movlw	88
  8641  004E' 0096               	movwf	22
  8642                           
  8643                           ; Start Timers
  8644                           ; Clear old timer interrupt flags
  8645  004F' 0020               	banksel	17
  8646  0050' 1011               	bcf	17,0	; Clear Timer1 flag
  8647  0051' 1091               	bcf	17,1	; Clear Timer2 flag
  8648                           
  8649                           ; Start Timer2 for PWM
  8650  0052' 0020               	banksel	28
  8651  0053' 3004               	movlw	4	; Prescaler 1:1, Timer2 ON
  8652  0054' 009C               	movwf	28
  8653  0055'                    WaitPWM:
  8654                           
  8655                           ; Wait for first PWM period to finish
  8656  0055' 0020               	banksel	17
  8657  0056' 1C91               	btfss	17,1
  8658  0057' 2855'              	goto	WaitPWM
  8659                           
  8660                           ; Enable PWM output pins
  8661  0058' 0021               	banksel	142
  8662  0059' 110E               	bcf	142,2	; CCP1 left motor
  8663  005A' 108E               	bcf	142,1	; CCP2 right motor
  8664                           
  8665                           ; Enable peripheral and global interrupts
  8666  005B' 0020               	banksel	11
  8667  005C' 170B               	bsf	11,6	; ((INTCON) and 0x7F), 6 = 1
  8668  005D' 178B               	bsf	11,7	; ((INTCON) and 0x7F), 7 = 1
  8669                           
  8670                           ; Start Timer1 last
  8671  005E' 0020               	banksel	24
  8672  005F' 3031               	movlw	49	; FOSC/4, 1:8 prescaler, Timer1 ON
  8673  0060' 0098               	movwf	24
  8674  0061' 2862'              	goto	Main
  8675  0062'                    Main:
  8676  0062' 2064'              	call	ServiceUART
  8677  0063' 2862'              	goto	Main
  8678  0064'                    ServiceUART:	
  8679                           ; UART Receive
  8680                           
  8681  0064' 0023               	banksel	413
  8682                           
  8683                           ; Check for overrun error
  8684  0065' 189D               	btfsc	413,1
  8685  0066' 2873'              	goto	UARTOverrun
